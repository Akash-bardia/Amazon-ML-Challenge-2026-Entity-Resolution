{
  "data_dir": "../student_resource/dataset",
  "work_dir": "work",
  "output_dir": "output",
  "validator_path": "../student_resource/utils/validate_submission.py",
  "seed": 42,
  "n_workers": 6,
  "prep_chunk_rows": 50000,
  "val_fraction": 0.05,
  "n_train_s1": 300000,
  "dict_min_count": 3,
  "dict_min_share": 0.5,
  "gazetteer_min_count": 5,
  "embed_model": "intfloat/multilingual-e5-small",
  "embed_prefix": "query: ",
  "embed_max_len": 64,
  "embed_batch": 512,
  "use_addr_embedding": true,
  "device": "auto",
  "knn_q_chunk": 512,
  "knn_p_chunk": 1000000,
  "k_dense_full": 30,
