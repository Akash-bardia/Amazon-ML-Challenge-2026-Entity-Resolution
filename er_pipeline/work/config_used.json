    "lambda_l2": 1.0,
    "max_bin": 255,
    "verbose": -1
  },
  "lgb_rounds": 3000,
  "lgb_early_stop": 100,
  "p_floor": 0.02,
  "judge_model": "Qwen/Qwen3-1.7B",
  "judge_band_low": 0.02,
  "judge_band_high": 0.98,
  "judge_n_train": 300000,
  "judge_max_len": 128,
  "judge_batch": 64,
  "judge_lr": 0.0002,
  "judge_epochs": 1,
  "judge_lora_r": 16
}